# Copy to worker/.env. Never share this file: the Supabase secret key can read and change everything.

# Supabase -> Project Settings -> API: the project URL and the SECRET key (not the publishable one)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Cloudflare R2: same bucket and API token as the web app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-translator

# Opens each person's API keys (saved encrypted in the web app's Settings). The SAME value as the web app's.
# There are no ElevenLabs or Claude keys here: every job runs on its owner's keys and voice.
SECRETS_KEY=

# Optional
# WORKER_ID=gonzalo-mac                 # name shown in the database (default: this computer's name)
# WORKER_KEEP_AWAKE=job                 # job = keep the computer awake while a job runs (default); off = don't
# VT_WORKER_DIR=~/Library/Application Support/Video Translator Worker   # where job folders go
#                                       # (Windows default: %LOCALAPPDATA%\Video Translator Worker)
# VT_VIDEO_CODEC=hevc_nvenc             # encoder to render with (default: the first that works, see docs/web-setup.md)
