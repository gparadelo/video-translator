# Copy to worker/.env. Never share this file: the Supabase secret key can read and change everything.

# Supabase -> Project Settings -> API: the project URL and the SECRET key (not the publishable one)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Cloudflare R2: same bucket and API token as the web app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-translator

# The services that do the work
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # used when a person's profile has no voice_id
ANTHROPIC_API_KEY=

# Optional
# WORKER_ID=gonzalo-mac                 # name shown in the database (default: this computer's name)
# WORKER_KEEP_AWAKE=job                 # job = keep the Mac awake while a job runs (default); off = don't
# VT_WORKER_DIR=~/Library/Application Support/Video Translator Worker   # where job folders go
