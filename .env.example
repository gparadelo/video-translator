# Only needed when running scripts/vt.py without the Claude Code plugin
# (the plugin asks for these when you install it).
# Copy to .env in your jobs folder or the folder you run from. Never share .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Only for `vt.py run` / `vt.py translate`, which translate with the Claude API
# (platform.claude.com -> API keys). The plugin doesn't need it: Claude Code translates there.
ANTHROPIC_API_KEY=

# Optional: a different voice for a specific language (e.g. ELEVENLABS_VOICE_ID_DE=...)
# VT_JOBS_DIR=/path/to/jobs   # lets you pass a job name instead of a path
