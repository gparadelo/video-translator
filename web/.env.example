# Copy to .env.local for local development; set the same values in Vercel for the deployed app.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 -> the bucket, and an API token with "Object Read & Write" on that bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-translator

# Claude API key (console.anthropic.com -> API Keys), used server-side by "Translate a title" (/api/titles)
ANTHROPIC_API_KEY=
