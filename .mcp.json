{
  "mcpServers": {
    "vt": {
      "command": "uv",
      "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/scripts/vt_mcp.py"],
      "env": {
        "ELEVENLABS_API_KEY": "${user_config.elevenlabs_api_key}",
        "ELEVENLABS_VOICE_ID": "${user_config.voice_id}",
        "VT_JOBS_DIR": "${user_config.jobs_dir}"
      }
    }
  }
}
